{
    "name": "nativephp/asgard",
    "description": "Server half of Asgard, NativePHP's server-driven UI protocol",
    "license": "proprietary",
    "authors": [
        {
            "name": "Simon Hamp",
            "email": "simon.hamp@me.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Native\\Asgard\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Native\\Asgard\\Tests\\": "tests"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Native\\Asgard\\AsgardServiceProvider"
            ],
            "aliases": {
                "Asgard": "Native\\Asgard\\Facades\\Asgard"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "test": "vendor/bin/pest",
        "format": "vendor/bin/pint"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
